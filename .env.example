# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace-me

# Local/temporary MCP authentication.
# For ChatGPT production, replace this with OAuth 2.1 MCP authorization.
MCP_BEARER_TOKEN=replace-me

# Safety gate for Jira write tools.
# Keep false until write operations have been explicitly validated.
MCP_WRITE_ENABLED=false

PORT=3000
